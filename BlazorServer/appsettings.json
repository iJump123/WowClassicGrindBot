{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Game.WowProcessInput": "Warning",
        "Core.ConfigurableInput": "Warning",
        "BlazorServer.MdnsAdvertisingService": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Pathing": {
    "Mode": "Local",
    "portv1": 5001,
    "hostv3": "127.0.0.1",
    "portv3": 47111
  },
  "Process": {
    "Id": -1
  },
  "Reader": {
    "Type": "DXGI",
    "UseGpu": true
  },
  "Diagnostics": {
    "Enabled": false
  },
  "Overlay": {
    "Enabled": false,
    "ShowTargeting": false,
    "ShowSkinning": false,
    "ShowTargetVsAdd": false
  }
}